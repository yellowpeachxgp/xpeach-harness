{
  "name": "@xpeach/xph-spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.0.15-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-spill": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-ptc-runtime-node": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-spill": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-fs-local": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-sandbox-local": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*",
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-spill-local": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-ptc-runtime": "workspace:*",
    "@xpeach/xph-attachment-local": "workspace:*",
    "@xpeach/xph-tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@xpeach/xph-agent-loop-testkit": "workspace:*"
  }
