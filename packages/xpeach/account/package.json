{
  "name": "@xpeach/xph-account",
  "description": "XPeach (New API) account Remote: profile and token listing served to Harness clients",
  "version": "0.0.36-alpha",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/xpeach/account"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-atomic-write": "workspace:*",
    "@xpeach/xph-api-remotes": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "@xpeach/xph-app-boot": "workspace:*",
    "@xpeach/xph-config-editor": "workspace:*",
    "@xpeach/xph-settings": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-pi-ai": "workspace:*",
    "@xpeach/xph-typert-registry": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "vitest": "^4.1.11",
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "@xpeach/ts-xpeach": "workspace:*",
    "@xpeach/xph-atomic-write": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "@xpeach/xph-util-values": "workspace:*",
    "js-yaml": "^4.3.2"
  }
}
