{
  "name": "@xpeach/xph-web-search-perplexity",
  "description": "Perplexity-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.0.32-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-perplexity"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-web": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-web": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-http-proxy": "workspace:*"
  }
}
