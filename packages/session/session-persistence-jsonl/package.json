{
  "name": "@xpeach/xph-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the DeepSeek Harness",
  "version": "0.0.17-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-persistence": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "dependencies": {
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-session-format": "workspace:*",
    "@xpeach/xph-session-format-catalog": "workspace:*",
    "@xpeach/xph-session-format-v3-to-v4": "workspace:*",
    "@xpeach/xph-node-addon-system": "workspace:~",
    "@xpeach/xph-schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-format-v0-to-v1": "workspace:*",
    "@xpeach/xph-session-persistence": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
