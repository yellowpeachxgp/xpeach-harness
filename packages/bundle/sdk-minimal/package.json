{
  "name": "@xpeach/xph-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.0.19-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@xpeach/xph-cordis-plugin-timer": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-attachment-local": "workspace:*",
    "@xpeach/xph-compaction-basic": "workspace:*",
    "@xpeach/xph-compaction-image-offload": "workspace:*",
    "@xpeach/xph-deepseek-llm-api-extensions": "workspace:*",
    "@xpeach/xph-jobs-local": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek-api-key": "workspace:*",
    "@xpeach/xph-llm-retry": "workspace:*",
    "@xpeach/xph-mcp-resources": "workspace:*",
    "@xpeach/xph-plugin-package-inventory-deepseek": "workspace:*",
    "@xpeach/xph-sandbox-local": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-sdk-app": "workspace:*",
    "@xpeach/xph-sdk-jsonrpc-server": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-log-deepseek": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-session-title": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-terminal": "workspace:*",
    "@xpeach/xph-terminal-bash": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*",
    "@xpeach/xph-tool-bash-persistent": "workspace:*",
    "@xpeach/xph-tool-fs": "workspace:*",
    "@xpeach/xph-tool-pwsh-persistent": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*",
    "@xpeach/xph-tool-working-directory": "workspace:*",
    "@xpeach/xph-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~"
  }
}
