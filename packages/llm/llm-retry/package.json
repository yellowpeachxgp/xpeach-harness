{
  "name": "@xpeach/xph-llm-retry",
  "description": "Provider-routed LLM request retry policy for the DeepSeek Harness",
  "version": "0.0.17-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-session-projection": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-cordis-plugin-include": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-llm-deepseek-api-key": "workspace:*",
    "@xpeach/xph-llm-mock-server": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
