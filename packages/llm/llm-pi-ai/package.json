{
  "name": "@xpeach/xph-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the DeepSeek Harness LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.0.27-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-authorization": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-util-values": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.1.0"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-authorization": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-llm-deepseek-api-key": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-http-proxy": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xpeach/xph-cordis-plugin-loader": {
      "optional": true
    }
  }
}
