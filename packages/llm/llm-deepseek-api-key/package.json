    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-launch-environment": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@xpeach/xph-cordis-plugin-loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  }
