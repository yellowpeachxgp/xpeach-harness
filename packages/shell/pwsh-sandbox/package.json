{
  "name": "@xpeach/xph-pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the DeepSeek Harness PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.0.8-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/pwsh-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-pwsh-local": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-pwsh-local": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-local": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
