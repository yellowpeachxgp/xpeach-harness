{
  "name": "@xpeach/xph-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.0.1-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-shell-env": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-jobs": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-ptc-runtime": "workspace:*",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-shell-env": "workspace:*",
    "@xpeach/xph-bash-local": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-jobs": "workspace:*",
    "@xpeach/xph-jobs-local": "workspace:*",
    "@xpeach/xph-tool-jobs": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*"
  }
