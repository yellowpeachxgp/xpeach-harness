{
  "name": "@xpeach/xph-bash-local",
  "description": "Local-subprocess implementation of the DeepSeek Harness bash executor seam",
  "version": "0.0.7-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
