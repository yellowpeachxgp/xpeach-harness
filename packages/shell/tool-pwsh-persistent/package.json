{
  "name": "@xpeach/xph-tool-pwsh-persistent",
  "description": "Model-facing owner-scoped persistent PowerShell tool backed by the Harness PTY service",
  "version": "0.0.13-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-pwsh-persistent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-terminal": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis-plugin-include": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-terminal": "workspace:*",
    "@xpeach/xph-terminal-bash": "workspace:*",
    "@xpeach/xph-pwsh-local": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  }
}
