{
  "name": "@xpeach/xph-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.0.3-alpha",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-instructions": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-permission-presets": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-util-values": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-instructions": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-bash-sandbox": "workspace:*",
    "@xpeach/xph-compaction": "workspace:*",
    "@xpeach/xph-fs-local": "workspace:*",
    "@xpeach/xph-fs-observation-policy": "workspace:*",
    "@xpeach/xph-fs-sandbox": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-llm-deepseek-api-key": "workspace:*",
    "@xpeach/xph-permission-presets": "workspace:*",
    "@xpeach/xph-ptc-runtime-node": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-shell": "workspace:*",
    "@xpeach/xph-shell-env": "workspace:*",
    "@xpeach/xph-subagent": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-tool-bash": "workspace:*",
    "@xpeach/xph-tool-fs": "workspace:*",
    "@xpeach/xph-tool-subagent": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
