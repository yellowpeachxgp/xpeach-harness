{
  "name": "@xpeach/xph-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.0.24-alpha",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~",
    "@xpeach/xph-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-fs-local": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-sandbox-local": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*"
  }
}
