{
  "name": "@xpeach/xph-experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-browser-use": "workspace:*",
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-browser-use": "workspace:*",
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-mcp-resources": "workspace:*",
    "@xpeach/xph-ptc-runtime": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-cordis-plugin-include": "workspace:~",
    "@xpeach/xph-attachment-local": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*",
    "@xpeach/xph-fs-local": "workspace:*"
  }
