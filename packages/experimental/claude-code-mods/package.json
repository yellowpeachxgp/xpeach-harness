{
  "name": "@xpeach/xph-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on DeepSeek Harness extension points",
  "version": "0.0.1-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xpeach/xph-util-crypto": "workspace:*",
    "@xpeach/xph-util-values": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-commands": "workspace:*",
    "@xpeach/xph-fs": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-storage-domain": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-user-questions": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
