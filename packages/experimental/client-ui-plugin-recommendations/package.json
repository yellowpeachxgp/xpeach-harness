{
  "version": "0.0.35-alpha",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "name": "@xpeach/xph-client-ui-plugin-recommendations",
  "description": "Official plugin card body with catalog text and enabling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-plugin-recommendations"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@xpeach/xph-api-remotes",
        "@xpeach/xph-client-locale",
        "@xpeach/xph-client-ui-plugin-manager",
        "@xpeach/xph-client-ui-action-cards"
      ]
    }
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-api-remotes": "workspace:*",
    "@xpeach/xph-client-locale": "workspace:*",
    "@xpeach/xph-client-ui-slots": "workspace:*",
    "@xpeach/xph-client-ui-primitives": "workspace:*",
    "react": "^18.2.0",
    "@xpeach/xph-plugin-recommendations": "workspace:*",
    "@xpeach/xph-client-store": "workspace:*",
    "@xpeach/xph-client-ui-plugin-manager": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-package-manifest": "workspace:*",
    "@xpeach/xph-client-ui-action-cards": "workspace:*",
    "@xpeach/xph-action-cards": "workspace:*",
    "zod": "4.4.3",
    "@xpeach/xph-client-test-runtime": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
