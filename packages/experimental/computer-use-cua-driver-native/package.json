{
  "name": "@xpeach/xph-experimental-computer-use-cua-driver-native",
  "description": "Experimental computer-use provider embedding the Cua Driver native npm SDK",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/computer-use-cua-driver-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-computer-use": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-tools": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "@trycua/cua-driver": "0.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-cordis-plugin-include": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-attachment-local": "workspace:*",
    "@xpeach/xph-computer-use": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-tools": "workspace:*"
  }
}
