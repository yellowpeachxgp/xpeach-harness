{
  "name": "@xpeach/xph-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.0.7-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-persistence": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xpeach/xph-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-loop": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*",
    "@xpeach/xph-attachment": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-mcp-client": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-persistence": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-subagent": "workspace:*",
    "@xpeach/xph-token-meter": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*"
  }
}
