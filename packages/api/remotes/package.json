{
  "name": "@xpeach/xph-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.0.20-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@xpeach/xph-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@xpeach/xph-deque": "workspace:*",
    "@xpeach/xph-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-scope": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-preset-registry": "workspace:*",
    "@xpeach/xph-api-gateway": "workspace:*",
    "@xpeach/xph-api-job-controller": "workspace:*",
    "@xpeach/xph-api-session-controller": "workspace:*",
    "@xpeach/xph-api-settings-controller": "workspace:*",
    "@xpeach/xph-api-workspace-controller": "workspace:*",
    "@xpeach/xph-api-workspace-files": "workspace:*",
    "@xpeach/xph-client-connection": "workspace:*",
    "@xpeach/xph-client-file-upload": "workspace:*",
    "@xpeach/xph-commands": "workspace:*",
    "@xpeach/xph-cordis-host-runner": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-file-reference": "workspace:*",
    "@xpeach/xph-goal": "workspace:*",
    "@xpeach/xph-host-plugin-inventory": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-message-feedback": "workspace:*",
    "@xpeach/xph-permission-presets": "workspace:*",
    "@xpeach/xph-schedule": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-reference": "workspace:*",
    "@xpeach/xph-settings": "workspace:*",
    "@xpeach/xph-subagent": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*",
    "@xpeach/xph-user-questions": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "zod": "4.4.3",
    "@xpeach/xph-command-feedback": "workspace:*",
    "@xpeach/xph-api-terminal-controller": "workspace:*",
    "@xpeach/xph-plugin-manager": "workspace:*",
    "@xpeach/xph-plugin-market": "workspace:*",
    "@xpeach/xph-client-ui-plugin-manager": "workspace:*",
    "@xpeach/xph-office-to-pdf": "workspace:*",
    "@xpeach/xph-api-account-controller": "workspace:*",
    "@xpeach/xph-deepseek-account": "workspace:*",
    "@xpeach/xph-client-product-analytics": "workspace:*"
  }
}
