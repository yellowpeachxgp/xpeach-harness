{
  "name": "@xpeach/xph-api-settings-controller",
  "description": "Remote owner for the configuration surfaces over the settings-domain seams",
  "version": "0.0.7-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/settings-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent-preset-registry": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-native-command": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-settings": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent-preset-registry": "workspace:*",
    "@xpeach/xph-credentials": "workspace:*",
    "@xpeach/xph-native-command": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-settings": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*"
  }
}
