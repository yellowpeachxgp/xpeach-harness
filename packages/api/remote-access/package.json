{
  "name": "@xpeach/xph-api-remote-access",
  "description": "Method-level Remote access control for non-owner Peers and the per-Peer access snapshot",
  "version": "0.0.7-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remote-access"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@xpeach/xph-api-gateway/client"
      ],
      "inject": [
        "@xpeach/xph-api-gateway",
        "@xpeach/xph-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xpeach/xph-typert-protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-api-gateway": "workspace:*",
    "@xpeach/xph-client-connection": "workspace:*",
    "@xpeach/xph-client-ui-renderer": "workspace:*",
    "@xpeach/xph-client-ui-slots": "workspace:*",
    "@xpeach/xph-host-webserver": "workspace:*",
    "@xpeach/xph-typert-registry": "workspace:*"
  }
}
