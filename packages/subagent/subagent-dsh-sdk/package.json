{
  "name": "@xpeach/xph-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.0.13-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-sdk-client": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-subagent": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*"
  },
  "dependencies": {
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-agent-instructions": "workspace:*",
    "@xpeach/xph-app-boot": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-llm-deepseek": "workspace:*",
    "@xpeach/xph-llm-deepseek-api-key": "workspace:*",
    "@xpeach/xph-loader-smoke": "workspace:*",
    "@xpeach/xph-sdk-client": "workspace:*",
    "@xpeach/xph-sdk-protocol": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-checkpoint-policy": "workspace:*",
    "@xpeach/xph-session-persistence-jsonl": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-skill-filesystem": "workspace:*",
    "@xpeach/xph-subagent": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-tool-subagent": "workspace:*"
  }
}
