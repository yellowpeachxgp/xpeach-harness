{
  "name": "@xpeach/xph-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xpeach/xph-app-boot": "workspace:*",
    "@xpeach/xph-atomic-write": "workspace:*",
    "@xpeach/xph-schemastery": "workspace:~",
    "execa": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "@xpeach/xph-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-host-plugin-inventory": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-hmr": "workspace:*",
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xpeach/xph-hmr": {
      "optional": true
    },
    "@xpeach/xph-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@xpeach/xph-package-manifest": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-host-plugin-inventory": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-hmr": "workspace:*",
    "@xpeach/xph-cordis-plugin-timer": "workspace:~",
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-sandbox-policy": "workspace:*",
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-session-projection": "workspace:*",
    "@xpeach/xph-sandbox": "workspace:*",
    "@xpeach/xph-user-approval": "workspace:*"
  }
}
