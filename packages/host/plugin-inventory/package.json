{
  "name": "@xpeach/xph-host-plugin-inventory",
  "description": "Read-only Remote projection of current Cordis Loader plugin state",
  "version": "0.0.27-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent-preset-registry": "workspace:*",
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@xpeach/xph-agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@xpeach/xph-app-boot": "workspace:*",
    "@xpeach/xph-package-manifest": "workspace:*",
    "@xpeach/xph-cordis-plugin-loader": "workspace:~",
    "@xpeach/xph-agent-preset-registry": "workspace:*",
    "@xpeach/xph-brand": "workspace:*",
    "@xpeach/xph-typert-protocol": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
