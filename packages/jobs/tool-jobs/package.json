{
  "name": "@xpeach/xph-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "0.0.25-beta",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-jobs": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-jobs": "workspace:*",
    "@xpeach/xph-jobs-local": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
