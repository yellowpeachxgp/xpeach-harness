{
  "name": "@xpeach/xph-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.0.15-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-spill": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@xpeach/xph-agent": "workspace:*",
    "@xpeach/xph-subprocess": "workspace:*",
    "@xpeach/xph-subprocess-local": "workspace:*",
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-output-retention": "workspace:*",
    "@xpeach/xph-session": "workspace:*",
    "@xpeach/xph-spill": "workspace:*",
    "@xpeach/xph-system-prompt": "workspace:*",
    "@xpeach/xph-timeout": "workspace:*",
    "@xpeach/xph-tools": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-working-directory": "workspace:*",
    "@xpeach/xph-agent-loop-testkit": "workspace:*"
  }
}
