{
  "name": "@xpeach/xph-system-prompt",
  "description": "System prompt assembly registry for the DeepSeek Harness",
  "version": "0.0.18-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/system-prompt"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  },
  "dependencies": {
    "@xpeach/xph-schemastery": "workspace:~"
  },
  "devDependencies": {
    "@xpeach/xph-llm": "workspace:*",
    "@xpeach/xph-scope": "workspace:*",
    "@xpeach/xph-cordis": "workspace:~"
  }
}
